# ---------------------------------------------------------------------------
# TwinMe web — environment. Copy to .env.local for development.
# Everything except SESSION_SECRET (prod) is optional: the on-device product
# (capture → Instant Twin → studio) runs with no backend at all.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sessions (HS256). Generate: openssl rand -base64 48
SESSION_SECRET=

# Supabase (Postgres + Storage). Service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (BotFather). Mini App URL: https://<host>/tg
TELEGRAM_BOT_TOKEN=
# Your bot's username without "@" — enables "Open in Telegram" links and Telegram sign-in on the web
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# setWebhook secret_token (openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
# Monthly prices in Telegram Stars
TELEGRAM_STARS_PRO=600
TELEGRAM_STARS_BARBER=2450
TELEGRAM_STARS_CLINIC=9950

# AI Stylist (Claude). Effort: low | medium | high
ANTHROPIC_API_KEY=
STYLIST_MODEL=claude-opus-5-5
STYLIST_EFFORT=low
# Optional failover provider (both required to enable)
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=

# Stripe (web subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BARBER=
STRIPE_PRICE_CLINIC=

# GPU worker → web notifications (HMAC), and Vercel Cron auth
RECON_WEBHOOK_SECRET=
CRON_SECRET=

FREE_TRANSFORMATIONS=3

# Show /lab in production builds (visual QA only)
NEXT_PUBLIC_ENABLE_LAB=0

# Optional: kick the GPU dispatcher immediately after an HD job is queued
RECON_TRIGGER_URL=
RECON_TRIGGER_TOKEN=
